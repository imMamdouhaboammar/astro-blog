---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import PixelPlaybookActions from "@components/PixelPlaybookActions.astro";
import PixelIcon from "@components/PixelIcon.astro";
import Icon from "@components/Icon.astro";
import getSortedPosts from "@utils/getSortedPosts";
import {
  getCategoryForPost,
  postUrl,
  PLAYBOOKS,
} from "@utils/categories";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);

// قسم 1: بوكسات أحدث الـ PLAYBOOKS
const playbooks = PLAYBOOKS;

// قسم 2: بوستات مثبتة (قائمة ثنائية الأعمدة بأيقونات مطفية تضيء ألوانها عند التمرير)
const pinnedPosts = sortedPosts.slice(0, 8);

// قسم 3: أزرار Pixels كبيرة لحسابات السوشال ميديا والمدونة
const socialChannels = [
  {
    name: "linkedin" as const,
    title: "LinkedIn",
    description: "شروحات ومقالات تقنية معمقة ومناقشات مهنية",
    url: "https://www.linkedin.com/in/mamdouh-aboammar/",
  },
  {
    name: "x" as const,
    title: "X (تويتر)",
    description: "أفكار سريعة، تحديثات يومية، وخلاصات برمجية",
    url: "https://x.com/imMamdouh",
  },
  {
    name: "facebook" as const,
    title: "فيسبوك",
    description: "مجتمع المتابعين ونقاشات تفاعلية حول البرمجة",
    url: "https://www.facebook.com/imMamdouhaboammar",
  },
  {
    name: "github" as const,
    title: "GitHub",
    description: "مستودعات الشفرة والمشاريع المفتوحة والأدوات",
    url: "https://github.com/imMamdouhaboammar",
  },
];
---

<Layout
  title="بلاي بوك ممدوح"
  description="بلاي بوكس معرفية مصوّرة في البرمجيات والأنظمة والذكاء الاصطناعي."
>
  <main class="home-panel" id="main">
    <!-- قسم 1: أحدث الـ PLAYBOOKS اللي تقدر تقرأها -->
    <section
      class="playbooks-section"
      id="playbooks"
      aria-labelledby="playbooks-heading"
    >
      <div class="playbooks-header">
        <h1 id="playbooks-heading">أحدث الـ PLAYBOOKS اللي تقدر تقرأها</h1>
        <div class="playbooks-header-actions">
          <PixelPlaybookActions
            subscribeHref={import.meta.env.PUBLIC_NEWSLETTER_URL}
            purchaseHref={import.meta.env.PUBLIC_PLAYBOOK_PURCHASE_URL}
            shareUrl="https://astro-blog.pages.dev/"
            shareTitle="بلاي بوك ممدوح"
            compact={true}
          />
        </div>
      </div>
      <div class="playbooks-grid">
        {
          playbooks.map(pb => (
            <a class="playbook-card" href={pb.url}>
              <span class="playbook-badge">{pb.countText}</span>
              <h3 class="playbook-title">{pb.title}</h3>
              <div class="playbook-thumb">
                <img src={pb.image} alt="" loading="lazy" />
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- قسم 2: بوستات مثبتة -->
    {
      pinnedPosts.length > 0 && (
        <section
          class="pinned-section"
          id="pinned"
          aria-labelledby="pinned-heading"
        >
          <div class="pinned-header">
            <h2 id="pinned-heading">أحدث البوستات</h2>
            <a class="pinned-view-all" href="/posts/">
              <span>عرض جميع البوستات</span>
              <Icon name="arrow" size={15} />
            </a>
          </div>
          <div class="pinned-grid">
            {pinnedPosts.map(post => {
              const cat = getCategoryForPost(post);
              const thumbImg = `/icons/${cat.icon}.png`;
              return (
                <a class="pinned-post-card" href={postUrl(post)}>
                  <div class="pinned-thumb">
                    <img src={thumbImg} alt="" loading="lazy" />
                  </div>
                  <div class="pinned-copy">
                    <h3 class="pinned-title">{post.data.title}</h3>
                    <div class="pinned-meta">
                      <span class="pinned-dot">●</span>
                      <span>{cat.name}</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <!-- قسم 3: لا تفوتك تحديثاتي على حسابات السوشال ميديا والمدونة وأزرار Pixels كبيرة -->
    <section
      class="social-section"
      id="social"
      aria-labelledby="social-heading"
    >
      <div class="social-heading">
        <h2 id="social-heading">
          لا تفوتك تحديثاتي على حسابات السوشال ميديا والمدونة
        </h2>
      </div>
      <div class="social-pixel-grid">
        {
          socialChannels.map(ch => (
            <a
              class="pixel-social-btn"
              href={ch.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${ch.title}، يفتح في علامة تبويب جديدة`}
            >
              <div class="pixel-social-icon">
                <PixelIcon name={ch.name} size={32} />
              </div>
              <div class="pixel-social-content">
                <h3>{ch.title}</h3>
                <span>{ch.description}</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
