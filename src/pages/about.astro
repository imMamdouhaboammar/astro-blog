---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { getCategoryForPost, postUrl } from "@utils/categories";
import { PROFILE, SOCIAL_CHANNELS } from "@utils/profile";
const posts = getSortedPosts(await getCollection("blog")).slice(0, 4);
const linkedinPosts = [
  {
    title: "أنت مش Creator، أنت Hostage",
    description: "عن امتلاك جمهورك وعدم الاعتماد الكامل على المنصات",
    id: "7441809080916221952",
    url: "https://www.linkedin.com/posts/mamdouh-aboammar_%D8%A3%D9%86%D8%AA-%D9%85%D8%B4-creator-%D8%A3%D9%86%D8%AA-hostage-%D8%B9%D8%A7%D9%8A%D8%B2%D9%83-%D8%AA%D8%B9%D9%85%D9%84-%D8%AD%D8%A7%D8%AC%D8%A9-activity-7441809080916221952-uEg2",
  },
  {
    title: "٥ أسئلة قبل ما تاخد قرار في حملة إعلانية",
    description: "عن اتخاذ قرارات التسويق بناءً على تحليل واضح",
    id: "7460736418018078720",
    url: "https://www.linkedin.com/posts/mamdouh-aboammar_%D9%87%D9%82%D9%88%D9%84%D9%83-%D8%AD%D8%A7%D8%AC%D8%A9-%D9%85%D8%AD%D8%B1%D8%AC%D8%A9-%D8%A3%D9%86%D8%A7-%D9%83%D9%86%D8%AA-%D8%A7%D9%84%D8%B4%D8%AE%D8%B5-%D8%A7%D9%84%D9%84%D9%8A-%D8%A8%D9%8A%D9%81%D8%AA%D8%AD-activity-7460736418018078720-tMli",
  },
];
const facebookPost = import.meta.env.PUBLIC_FEATURED_FACEBOOK_POST_URL?.trim();
const facebookEmbed = facebookPost && /^https:\/\/(?:www\.|m\.)?facebook\.com\//.test(facebookPost)
  ? `https://www.facebook.com/plugins/post.php?href=${encodeURIComponent(facebookPost)}&show_text=true&width=500`
  : undefined;
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    "@id": new URL("/about/#person", Astro.site).href,
    name: PROFILE.englishName,
  },
};
---
<Layout
  title="عنّي"
  description="تعرف على ممدوح أبو عمّار: مدير رقمي ومهتم بالنمو وعلوم التسويق وبناء المنتجات المدعومة بالذكاء الاصطناعي."
  schema={schema}
  ogType="profile"
>
  <main id="main" class="about-page">
    <header class="about-hero">
      <img class="about-portrait" src={PROFILE.avatar} width="172" height="172" alt="بورتريه Pixel Art لممدوح أبو عمّار" fetchpriority="high" />
      <h1>ممدوح أبو عمّار</h1>
      <p class="about-role" lang="en" dir="ltr">{PROFILE.role}</p>
      <p class="about-summary">بشتغل في المنطقة اللي بتتقاطع فيها الاستراتيجية الرقمية، والتسويق، وبناء المنتجات المدعومة بالذكاء الاصطناعي. بحب أحوّل الأفكار المعقدة لحاجات عملية تقدر تستخدمها في شغلك.</p>
      <div class="about-links">
        <a class="about-primary" href={PROFILE.social.whatsapp} target="_blank" rel="noopener noreferrer">اتواصل معايا على واتساب ↗</a>
        <a class="about-secondary" href="/posts/">اقرأ المقالات</a>
      </div>
    </header>
    <section class="about-section about-bio" aria-labelledby="about-story">
      <div>
        <h2 id="about-story">شوية عنّي</h2>
        <p>أنا Digital Director في 4STEPS، وخلال أكتر من 8 سنين اشتغلت على التسويق، والاستراتيجية، والكتابة، وتجارب المستخدم، ومشاريع في مصر والسعودية والإمارات وقطر وكندا.</p>
        <p>المساحة دي بكتب فيها عن الحاجات اللي بتستحق نتعلمها بعمق، خصوصًا الـ Marketing Science والـ AI Engineering والأنظمة اللي بتساعدنا ناخد قرارات أحسن.</p>
      </div>
      <div class="about-expertise">
        <h3>الموضوعات اللي بهتم بيها</h3>
        <ul><li>Marketing Science & Measurement</li><li>Growth & Digital Strategy</li><li>AI Products & Open Source</li><li>UX Writing & Conversion</li></ul>
      </div>
    </section>
    <section class="about-section" aria-labelledby="about-read">
      <div class="about-section-head"><h2 id="about-read">ابدأ من هنا</h2><a href="/posts/">كل المقالات ↗</a></div>
      <div class="about-post-grid">
        {posts.map(post => {
          const category = getCategoryForPost(post);
          return (
            <a class="about-post" href={postUrl(post)}>
              <span class="about-category">{category.name}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="about-read-link">اقرأ المقال ↗</span>
            </a>
          );
        })}
      </div>
    </section>
    <section class="about-section" aria-labelledby="about-social">
      <div class="about-section-head"><h2 id="about-social">تلاقيني فين؟</h2></div>
      <div class="about-social-grid">
        {SOCIAL_CHANNELS.map(ch => (
          <a href={PROFILE.social[ch.key]} target="_blank" rel="noopener noreferrer">
            <strong>{ch.title} ↗</strong><span>{ch.description}</span>
          </a>
        ))}
        <a href={`mailto:${PROFILE.email}`}><strong>البريد الإلكتروني ↗</strong><span>{PROFILE.email}</span></a>
      </div>
    </section>
    <section class="about-section" aria-labelledby="about-featured">
      <div class="about-section-head"><h2 id="about-featured">منشورات من برّه المدونة</h2></div>
      <div class="about-embed-grid">
        {linkedinPosts.map(post => (
          <article class="about-embed">
            <div class="about-embed-header"><strong>LinkedIn</strong><a href={post.url} target="_blank" rel="noopener noreferrer">فتح المنشور ↗</a></div>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
            <iframe title={`منشور LinkedIn: ${post.title}`} src={`https://www.linkedin.com/embed/feed/update/urn:li:activity:${post.id}`} loading="lazy" width="100%" height="280" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </article>
        ))}
        <article class="about-embed">
          <div class="about-embed-header"><strong>Facebook</strong><a href={facebookPost && facebookEmbed ? facebookPost : PROFILE.social.facebook} target="_blank" rel="noopener noreferrer">افتح فيسبوك ↗</a></div>
          <h3>بوستات ونقاشات على فيسبوك</h3>
          {facebookEmbed ? <iframe title="منشور ممدوح أبو عمّار على فيسبوك" src={facebookEmbed} loading="lazy" width="100%" height="320" referrerpolicy="strict-origin-when-cross-origin"></iframe> : <p>أشارك تجارب وأفكار من الشغل على فيسبوك. تقدر تتابعها من الحساب مباشرة.</p>}
        </article>
      </div>
    </section>
  </main>
</Layout>
<style>
  .about-page{max-width:1150px;margin:24px auto 0;padding:48px;background:var(--surface);border-radius:12px}
  .about-hero{text-align:center;padding:24px 0 54px;border-bottom:1px solid var(--line)}
  .about-portrait{display:block;width:172px;height:172px;margin:0 auto 24px;object-fit:cover;image-rendering:pixelated;background:#fff8e9;border:4px solid #432b1c;border-radius:22px;box-shadow:0 8px 0 #d5bc97}
  .about-hero h1{font-family:var(--font-heading);font-size:clamp(34px,5vw,56px);line-height:1.4;margin:0}
  .about-role{color:var(--accent-dark);font-size:14px;font-weight:700;letter-spacing:.015em;margin:8px 0 18px}
  .about-summary{max-width:660px;margin:0 auto;font-size:18px;line-height:2;color:#3f4a56;text-wrap:pretty}
  .about-links{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:26px}
  .about-links a{min-height:46px;display:inline-flex;align-items:center;justify-content:center;border-radius:9px;padding:10px 20px;font-weight:700}
  .about-primary{background:#286d60;color:white}.about-secondary{border:1px solid #bfc6cb}
  .about-section{padding:44px 0;border-bottom:1px solid var(--line)}.about-section:last-child{border:0;padding-bottom:0}
  .about-section h2{font-family:var(--font-heading);font-size:29px;line-height:1.5;margin:0 0 20px}
  .about-bio{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:55px}
  .about-bio p{font-size:17px;line-height:2.1;margin:0 0 14px;max-width:65ch}
  .about-expertise{padding:24px;background:#f6f8f7;border-radius:12px}
  .about-expertise h3{font-size:16px;margin:0 0 16px}
  .about-expertise ul{padding-inline-start:20px;margin:0;line-height:2.15;direction:ltr;text-align:left}
  .about-section-head{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:20px}
  .about-section-head h2{margin:0}
  .about-section-head>a{color:var(--accent-dark);font-weight:700;white-space:nowrap}
  .about-post-grid,.about-embed-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .about-post{display:flex;flex-direction:column;min-width:0;background:#f8faf9;padding:22px;border:1px solid var(--line);border-radius:12px}
  .about-post:hover,.about-post:focus-visible{border-color:var(--accent-dark);background:#f3f8f6}
  .about-category{font-size:12px;color:var(--accent-dark);font-weight:700}
  .about-post h3{font-family:var(--font-heading);font-size:19px;margin:12px 0 8px;line-height:1.7;overflow-wrap:anywhere}
  .about-post p{color:var(--muted);font-size:14px;line-height:1.9;margin:0 0 16px}
  .about-read-link{margin-top:auto;color:var(--accent-dark);font-weight:700;font-size:13px}
  .about-social-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .about-social-grid a{display:flex;flex-direction:column;gap:6px;padding:17px;border:1px solid var(--line);border-radius:10px;min-width:0}
  .about-social-grid a:hover{border-color:var(--accent-dark)}.about-social-grid strong{font-size:15px}
  .about-social-grid span{color:var(--muted);font-size:12px;overflow-wrap:anywhere}
  .about-embed{min-width:0;padding:20px;border:1px solid var(--line);border-radius:12px;background:#fafbfb}
  .about-embed-header{display:flex;justify-content:space-between;gap:12px;font-size:13px}
  .about-embed-header a{color:var(--accent-dark);font-weight:700}
  .about-embed h3{font-size:17px;margin:15px 0 8px;line-height:1.7}
  .about-embed p{font-size:14px;line-height:1.9;color:var(--muted)}
  .about-embed iframe{border:0;border-radius:8px;max-width:100%;display:block;margin-top:12px;background:#fff}
  @media(max-width:900px){.about-page{margin:20px 24px 0;padding:32px}.about-bio{gap:28px}.about-social-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:640px){.about-page{margin:16px 14px 0;padding:24px 20px}.about-portrait{width:140px;height:140px}.about-hero{padding-top:10px}.about-summary{font-size:16px}.about-section{padding:32px 0}.about-section h2{font-size:24px}.about-bio,.about-post-grid,.about-embed-grid{grid-template-columns:minmax(0,1fr)}.about-social-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.about-social-grid a{padding:12px}.about-links a{width:100%}}
</style>
