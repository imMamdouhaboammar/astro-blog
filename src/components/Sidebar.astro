---
import { PLAYBOOKS } from "@utils/categories";

export interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<aside class="category-sidebar" aria-label="الـ Playbooks">
  <details class="category-disclosure" open>
    <summary>
      <span>الـ Playbooks</span>
      <svg
        class="disclosure-arrow"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        aria-hidden="true"
      >
        <path
          d="m4 6 4 4 4-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"></path>
      </svg>
    </summary>
    <nav class="category-nav" aria-label="الـ Playbooks">
      {
        PLAYBOOKS.map(pb => (
          <a
            href={pb.url}
            class:list={[{ selected: active === pb.slug || active === pb.id }]}
            aria-current={
              active === pb.slug || active === pb.id ? "page" : undefined
            }
          >
            <img src={pb.icon} alt="" width="18" height="18" loading="lazy" />
            <span>{pb.title}</span>
          </a>
        ))
      }
    </nav>
  </details>
</aside>
<script>
  const panel = document.querySelector<HTMLDetailsElement>(
    ".category-disclosure"
  );
  const mobile = window.matchMedia("(max-width: 960px)");
  const summary = panel?.querySelector("summary");
  function syncPanel() {
    if (!panel) return;
    const compact = mobile.matches;
    panel.open = !compact;
    if (summary) summary.tabIndex = compact ? 0 : -1;
  }
  syncPanel();
  mobile.addEventListener("change", syncPanel);
</script>
