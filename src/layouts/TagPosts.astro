---
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import GuideCard from "@components/GuideCard.astro";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, paginatedPosts, tag, tagName } = Astro.props;
---

<Layout
  title={`وسم: ${tagName} | ${SITE.title}`}
  description={`جميع البلاي بوكس التي تحمل وسم "${tagName}".`}
>
  <main class="home-panel" id="main">
    <div class="home-heading">
      <div>
        <h1>وسم: {tagName}</h1>
        <p>جميع البلاي بوكس المصنفة تحت وسم &ldquo;{tagName}&rdquo;</p>
      </div>
    </div>

    <div class="guide-grid">
      {paginatedPosts.map((post, i) => <GuideCard post={post} index={i} />)}
    </div>

    {
      totalPages > 1 && (
        <nav class="pagination-nav" aria-label="تنقل بين الصفحات">
          {currentPage > 1 && (
            <a
              href={`/tags/${tag}${
                currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""
              }/`}
            >
              السابق
            </a>
          )}
          <span>
            {new Intl.NumberFormat("ar").format(currentPage)} /{" "}
            {new Intl.NumberFormat("ar").format(totalPages)}
          </span>
          {currentPage < totalPages && (
            <a href={`/tags/${tag}/${currentPage + 1}/`}>التالي</a>
          )}
        </nav>
      )
    }
  </main>
</Layout>
