---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import GuideCard from "@components/GuideCard.astro";
import { SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;
---

<Layout
  title={`جميع البلاي بوكس - صفحة ${currentPage} | ${SITE.title}`}
  description="تصفّح جميع البلاي بوكس المنشورة"
>
  <main class="home-panel" id="main">
    <div class="home-heading">
      <div>
        <h1>جميع البلاي بوكس</h1>
        <p>
          صفحة {new Intl.NumberFormat("ar").format(currentPage)} من{" "}
          {new Intl.NumberFormat("ar").format(totalPages)}
        </p>
      </div>
    </div>

    <div class="guide-grid">
      {paginatedPosts.map((post, i) => <GuideCard post={post} index={i} />)}
    </div>

    {
      totalPages > 1 && (
        <nav class="pagination-nav" aria-label="تنقل بين الصفحات">
          {currentPage > 1 && (
            <a
              href={`/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
            >
              السابق
            </a>
          )}
          <span>
            {new Intl.NumberFormat("ar").format(currentPage)} /{" "}
            {new Intl.NumberFormat("ar").format(totalPages)}
          </span>
          {currentPage < totalPages && (
            <a href={`/posts/${currentPage + 1}/`}>التالي</a>
          )}
        </nav>
      )
    }
  </main>
</Layout>
