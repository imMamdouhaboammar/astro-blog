---
import Layout from "@layouts/Layout.astro";
import Sidebar from "@components/Sidebar.astro";
import Share from "@components/Share.astro";
import Icon from "@components/Icon.astro";
import type { CollectionEntry } from "astro:content";
import {
  getCategoryForPost,
  categoryUrl,
  postUrl,
  getCategoryPosts,
  getPostImage,
} from "@utils/categories";
import getSortedPosts from "@utils/getSortedPosts";
import { getCollection } from "astro:content";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content } = await post.render();

const category = getCategoryForPost(post);
const allPosts = await getCollection("blog");
const sortedPosts = getSortedPosts(allPosts);
const categoryPosts = getCategoryPosts(sortedPosts, category.slug);

// Related posts: up to 4 other posts from the same category or general library
let related = categoryPosts.filter(p => p.slug !== post.slug).slice(0, 4);
if (related.length === 0) {
  related = sortedPosts.filter(p => p.slug !== post.slug).slice(0, 4);
}

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const postCanonical = canonicalURL ?? new URL(postUrl(post), Astro.site).href;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      headline: title,
      description,
      datePublished: pubDatetime.toISOString(),
      dateModified: (modDatetime ?? pubDatetime).toISOString(),
      inLanguage: "ar",
      mainEntityOfPage: postCanonical,
      articleSection: category.name,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "البلاي بوكس",
          item: Astro.site?.href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: category.name,
          item: new URL(categoryUrl(category), Astro.site).href,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: title,
          item: postCanonical,
        },
      ],
    },
  ],
};

const dateObj = new Date(modDatetime ?? pubDatetime);
const dateIso = dateObj.toISOString();
const formattedDate = new Intl.DateTimeFormat("ar-EG", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(dateObj);
---

<Layout
  title={title}
  author={author}
  description={description}
  ogImage={ogImageUrl}
  canonicalURL={postCanonical}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  schema={schema}
  scrollSmooth={true}
>
  <div class="content-shell">
    <Sidebar active={category.slug} />
    <main id="main" class="article-column">
      <article class="article-panel">
        <div class="tags">
          {
            tags.map((t, i) => (
              <span class={`tag tag-${i % 2}`} dir="auto">
                {t}
              </span>
            ))
          }
        </div>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-toolbar">
          <Share />
          <a class="category-return" href={categoryUrl(category)}>
            <span>{category.name}</span>
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <div class="article-body">
          {
            getPostImage(post) && (
              <div class="article-hero">
                <img
                  src={getPostImage(post)}
                  alt={title}
                  class="article-hero-img"
                  loading="eager"
                />
              </div>
            )
          }
          <Content />
        </div>
        <div class="article-end">
          <time datetime={dateIso}>آخر تحديث: {formattedDate}</time>
          <a href={categoryUrl(category)}>
            <span>العودة إلى التصنيف</span>
            <Icon name="arrow" size={16} />
          </a>
        </div>
      </article>

      {
        related.length > 0 && (
          <section class="related-section">
            <div class="section-heading">
              <h2>بلاي بوكس ذات صلة</h2>
              <a href={categoryUrl(category)}>
                <span>عرض التصنيف</span>
                <Icon name="arrow" size={17} />
              </a>
            </div>
            <div class="related-grid">
              {related.map(r => (
                <a href={postUrl(r)} class="related-guide">
                  <h3>{r.data.title}</h3>
                  <p>{r.data.description}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </main>
  </div>
</Layout>

<script>
  function setupCodeBlockCopy() {
    const codeBlocks = document.querySelectorAll(".article-body pre");
    codeBlocks.forEach(block => {
      if (!(block instanceof HTMLElement)) return;
      if (block.querySelector(".copy-code-btn")) return;
      block.style.position = "relative";
      const btn = document.createElement("button");
      btn.className = "copy-code-btn";
      btn.type = "button";
      btn.setAttribute("aria-label", "نسخ الشفرة");
      btn.textContent = "نسخ";
      btn.style.cssText =
        "position: absolute; top: 8px; right: 8px; font-size: 11px; padding: 3px 8px; border-radius: 4px; background: rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.1); color: inherit; cursor: pointer;";
      btn.addEventListener("click", async () => {
        const codeBlock = block.querySelector("code");
        const code =
          codeBlock instanceof HTMLElement
            ? codeBlock.innerText
            : block.innerText;
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = "تم النسخ";
          setTimeout(() => {
            btn.textContent = "نسخ";
          }, 2000);
        } catch (_err) {
          btn.textContent = "تعذّر النسخ";
          setTimeout(() => {
            btn.textContent = "نسخ";
          }, 2000);
        }
      });
      block.appendChild(btn);
    });
  }
  setupCodeBlockCopy();
  document.addEventListener("astro:after-swap", setupCodeBlockCopy);
</script>
