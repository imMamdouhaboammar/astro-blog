---
import { LOCALE, SITE } from "@config";
import "@styles/global.css";
import PixelNavbar from "@components/PixelNavbar.astro";
import { formatPageTitle } from "@utils/formatPageTitle";
import BlogFooter from "@components/BlogFooter.astro";
import { PROFILE } from "@utils/profile";

const socialLinks = PROFILE.social;

export interface Props {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  schema?: object;
  ogType?: "website" | "article" | "profile";
  scrollSmooth?: boolean;
}

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  schema,
  ogType,
  scrollSmooth = false,
} = Astro.props;

const pageTitle = formatPageTitle(title, SITE.title);
const loginHref = import.meta.env.PUBLIC_LOGIN_URL?.trim() || undefined;
const whatsappHref = import.meta.env.PUBLIC_WHATSAPP_URL?.trim() || PROFILE.social.whatsapp;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();

const socialImageURL = new URL(
  ogImage ?? SITE.ogImage ?? "og.png",
  SITE.website
).href;

const profileSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", SITE.website).href,
      name: SITE.title,
      url: SITE.website,
      inLanguage: "ar",
      description: SITE.desc,
      publisher: { "@id": new URL("/about/#person", SITE.website).href },
      potentialAction: {
        "@type": "SearchAction",
        target: new URL("/search/?q={search_term_string}", SITE.website).href,
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Person",
      "@id": new URL("/about/#person", SITE.website).href,
      name: PROFILE.englishName,
      alternateName: PROFILE.name,
      url: new URL("/about/", SITE.website).href,
      image: new URL(PROFILE.avatar, SITE.website).href,
      jobTitle: "Digital Director",
      sameAs: [
        PROFILE.website,
        PROFILE.social.linkedin,
        PROFILE.social.facebook,
        PROFILE.social.github,
      ],
    },
  ],
};
---

<!doctype html>
<html
  lang={LOCALE.lang ?? "ar"}
  dir="rtl"
  class:list={[{ "scroll-smooth": scrollSmooth }]}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#edeef1" />

    <!-- General Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {
      googleSiteVerification && (
        <meta name="google-site-verification" content={googleSiteVerification} />
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="آخر مقالات بلاي بوك ممدوح" />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:type" content={ogType ?? (schema ? "article" : "website")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(profileSchema).replace(/</g, "\\u003c")} />

    <!-- JSON-LD Structured Data -->
    {
      schema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">انتقل إلى المحتوى</a>
    <PixelNavbar
      socialLinks={socialLinks}
      whatsappHref={whatsappHref}
      loginHref={loginHref}
      homeHref="/"
    />

    <slot />

    <BlogFooter />
    <div id="feedback" class="feedback" role="status" aria-live="polite"></div>

    <script>
      let timer = 0;
      function announce(message = "") {
        const feedback = document.querySelector("#feedback");
        if (!feedback) return;
        clearTimeout(timer);
        feedback.textContent = message;
        feedback.classList.add("visible");
        timer = window.setTimeout(
          () => feedback.classList.remove("visible"),
          4000
        );
      }
      document.querySelectorAll("[data-share]").forEach(button => {
        if (button instanceof HTMLElement) {
          button.hidden = false;
        }
        button.addEventListener("click", async () => {
          try {
            if (navigator.share) {
              await navigator.share({
                title: document.title,
                url: window.location.href,
              });
            } else if (navigator.clipboard && window.isSecureContext) {
              await navigator.clipboard.writeText(window.location.href);
              announce("تم نسخ الرابط");
            } else {
              announce("يمكنك نسخ رابط الصفحة من شريط العنوان");
            }
          } catch (error) {
            if (error instanceof Error && error.name === "AbortError") return;
            announce("تعذّرت المشاركة. يمكنك نسخ الرابط من شريط العنوان");
          }
        });
      });
    </script>
  </body>
</html>
